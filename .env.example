# Configuration de l'environnement de l'application To-Do List

# Base de données
DB_PATH=database/todo_list.sqlite

# Environnement applicatif (local, production, test)
APP_ENV=local

# Configuration Mailer (log ou mail)
MAIL_DRIVER=log
MAIL_FROM=no-reply@todo-list.fr
MAIL_LOG_PATH=database/mail.log

# Sécurité & Sessions
SESSION_SECRET=todo_list_secure_session_key_2026_x89a
