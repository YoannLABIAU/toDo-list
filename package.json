{
  "name": "todo-list",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/style.css",
    "build:ts": "tsc",
    "build": "npm run build:ts && npm run build:css",
    "watch": "tailwindcss -i ./src/css/input.css -o ./public/css/style.css --watch",
    "test": "playwright test",
    "test:allure": "playwright test --reporter=line,allure-playwright && allure generate allure-results -o allure-report --clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.10.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
